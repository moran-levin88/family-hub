NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin (server-side, bypasses security rules)
# Base64-encode the service account JSON: base64 -i service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=your-base64-encoded-service-account-json

# Comma-separated list of emails allowed to sign in
NEXT_PUBLIC_ALLOWED_EMAILS=you@gmail.com,spouse@gmail.com
